# ---- App (Vite). Solo valores públicos: todo lo que empiece por VITE_ acaba en el navegador. ----
# Adaptador de datos: "mock" (por defecto, modo demo con la API local de server/) o "supabase".
VITE_DATA_ADAPTER=mock
# Solo con VITE_DATA_ADAPTER=supabase. La clave anon es pública y no tiene permisos sobre las tablas (RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Servidor de demo (server/index.js). Nunca en el frontend. ----
PORT=8080
# 1 si hay un proxy de confianza delante (Cloudflare): usa su cabecera de IP y redirige a HTTPS.
TRUST_PROXY=0
# Secreto para firmar los tokens de vista de la consulta. Si falta, se genera uno al arrancar.
SESSION_SECRET=
# PIN del «Taller Demo» y si la demo está activa (muestra el PIN en la pantalla de acceso).
DEMO_PIN=2468
DEMO_MODE=1

# ---- Edge Functions de Supabase (se configuran con `supabase secrets set`, no en este fichero). ----
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase.
# ALLOWED_ORIGINS=https://tu-dominio.example        (lista separada por comas)
# VIEW_TOKEN_SECRET=<32 bytes aleatorios>
# JWT_SECRET=<JWT secret del proyecto, para el token de Realtime>
# COOKIE_SAMESITE=None                              (Strict si la función va detrás del mismo dominio)

# Con DEMO_MODE=0 no hay «Taller Demo»: el taller sale de estas variables (ver README, «Modo demo y entrega a un taller real»).
# WORKSHOP_CODE=
# WORKSHOP_PIN=
# WORKSHOP_NAME=
# WORKSHOP_LIFTS=2
# WORKSHOP_PIT=1
# WORKSHOP_COLOR=#2F6FED
