# Copia a .env en el servidor. NUNCA subas .env al repositorio.
PORT=8080
# 1 si el servidor va detrás de Cloudflare / un proxy: toma la IP real y fuerza HTTPS.
TRUST_PROXY=0
# IP de los proxies de confianza (coma). Solo de ellos se aceptan X-Forwarded-For / CF-Connecting-IP.
TRUSTED_PROXIES=127.0.0.1,::1
# Webhooks (por ejemplo n8n). Vacíos = modo maqueta: se valida y no se guarda nada.
BOOKING_WEBHOOK_URL=
LISTA_WEBHOOK_URL=
WEBHOOK_SECRET=
