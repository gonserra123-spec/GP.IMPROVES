# Copia este archivo a .env (o define las variables en el alojamiento). Nunca subas el .env a GitHub.
NODE_ENV=production
SESSION_SECRET=
ADMIN_KEY=
PUBLIC_URL=https://taller.ejemplo.es
# Dónde vive la app de citas del cliente (tridom-citas); sale en Ajustes de cada taller
CITAS_URL=https://citas.ejemplo.es
DATA_DIR=/var/data/tridom-taller
TRUST_PROXY=1

# Correo (Resend). Sin RESEND_API_KEY el modo es «pruebas»: los correos solo se guardan en data/outbox-dev.
RESEND_API_KEY=
MAIL_FROM=avisos@ejemplo.es
RESEND_WEBHOOK_SECRET=

# Hoja de Google (cuenta de servicio): el JSON entero o la ruta a su archivo.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
